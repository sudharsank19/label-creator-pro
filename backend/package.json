{
  "name": "label-creator-pro-backend",
  "version": "1.0.0",
  "description": "Label Creator Pro REST API for iPhone Spare Parts & Service Center",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "postinstall": "prisma generate && prisma db push && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "label",
    "barcode",
    "qr",
    "printer",
    "express",
    "prisma"
  ],
  "author": "Label Creator Pro",
